{
  "name": "satellite-dataset-studio-ui",
  "private": true,
  "version": "2.4.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write src tests *.ts *.json *.yaml *.html *.md",
    "format:check": "prettier --check src tests *.ts *.json *.yaml *.html *.md",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
