{
  "name": "satellite-dataset-studio-ui",
  "private": true,
  "version": "4.0.0-web",
  "type": "module",
  "scripts": {
    "dev": "node ../../tools/prepare-web-assets.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node ../../tools/prepare-web-assets.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write src tests *.ts *.json *.yaml *.html *.md",
    "format:check": "prettier --check src tests *.ts *.json *.yaml *.html *.md",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
